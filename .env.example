# ── Supabase (auto-injected into edge functions; set manually for CLI use) ─────
PROJECT_URL=https://your-project-id.supabase.co
ANON_KEY=your-supabase-anon-key
SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── AI Provider ────────────────────────────────────────────────────────────────
# AI_PROVIDER defaults to "openrouter". Set to "cerebras" to use Cerebras instead.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.0-flash-001   # optional, has a default

# Cerebras (only needed if AI_PROVIDER=cerebras)
CEREBRAS_API_KEY=your-cerebras-api-key
CEREBRAS_MODEL=qwen-3-235b-a22b-instruct-2507   # optional, has a default

# ── Google OAuth / Gmail / Calendar API ───────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ── Gmail Pub/Sub (webhook for real-time new-email notifications) ─────────────
PUBSUB_TOPIC=projects/your-gcp-project/topics/your-topic
PUBSUB_VERIFICATION_TOKEN=your-pubsub-verification-token   # optional but recommended

# ── Token Encryption (Fernet) ─────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your-fernet-encryption-key

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ── Zoom (optional) ───────────────────────────────────────────────────────────
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Defaults to allowing all.
ALLOWED_FRONTEND_ORIGINS=https://runemail.org,https://www.runemail.org
